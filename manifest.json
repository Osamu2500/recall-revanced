{
  "manifest_version": 3,
  "name": "Recall Revanced",
  "version": "6.0.0",
  "description": "Premium Glassmorphism UI, Wide Views, and Visual Command Palette for Recall.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "https://app.recall.it/*",
    "https://app.getrecall.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.recall.it/*",
        "https://app.getrecall.ai/*"
      ],
      "js": [
        "src/content/core/selectors.js",
        "src/content/core/router.js",
        "src/content/core/state.js",
        "src/content/core/memory-scroll.js",
        "src/content/core/spa-router.js",
        "src/content/core/dom-observer.js",
        "src/content/features/cards-enhancer.js",
        "src/content/core/hotkeys.js",
        "src/content/pages/home-page.js",
        "src/content/pages/item-page.js",
        "src/content/pages/spaced-repetition-page.js",
        "src/content/pages/home-cards.js",
        "src/content/pages/settings-page.js",
        "src/content/pages/graph-page.js",
        "src/content/pages/chat-page.js",
        "src/content/pages/review-page.js",
        "src/content/features/media-tools.js",
        "src/content/features/code-tools.js",
        "src/content/features/chat-prompts/chat-prompts-core.js",
        "src/content/features/chat-prompts/chat-prompts-init.js",
        "src/content/features/minimap.js",
        "src/content/main.js"
      ],
      "css": [
        "src/themes/core/base.css",
        "src/themes/components/spaced-grid.css",
        "src/themes/core/premium.css",
        "src/themes/features/zen-mode.css",
        "src/themes/features/minimap.css",
        "src/themes/features/code-tools.css",
        "src/themes/features/chat-multi-select.css",
        "src/themes/palettes/dracula.css",
        "src/themes/palettes/tokyo.css",
        "src/themes/palettes/nord.css",
        "src/themes/components/immersive-cards.css",
        "src/themes/pages/home.css",
        "src/themes/pages/chat.css",
        "src/themes/pages/review.css",
        "src/themes/pages/graph.css",
        "src/themes/pages/item.css",
        "src/themes/pages/settings.css",
        "src/themes/components/search-modal.css",
        "src/themes/components/sidebar.css",
        "src/themes/components/modals.css",
        "src/themes/components/mui-overrides.css",
        "src/themes/components/context-menus.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/features/chat-prompts/chat-prompts-core.js",
        "src/content/features/chat-prompts/chat-prompts-global.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/themes/core/base.css",
        "src/themes/*/*.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
