{
  "manifest_version": 3,
  "name": "Recall Revanced",
  "version": "6.0.0",
  "description": "Premium Glassmorphism UI, Wide Views, and Visual Command Palette for Recall.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "https://app.recall.it/*",
    "https://app.getrecall.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.recall.it/*",
        "https://app.getrecall.ai/*"
      ],
      "js": [
        "src/content/core/selectors.js",
        "src/content/core/router.js",
        "src/content/core/state-manager.js",
        "src/content/core/dom-observer.js",
        "src/content/core/hotkeys.js",
        "src/content/pages/home/index.js",
        "src/content/pages/item/index.js",
        "src/content/pages/spaced-repetition/index.js",
        "src/content/pages/home/cards.js",
        "src/content/pages/settings/index.js",
        "src/content/pages/graph/index.js",
        "src/content/pages/search/index.js",
        "src/content/pages/chat/index.js",
        "src/content/pages/review/index.js",
        "src/content/features/enhancements/media-tools.js",
        "src/content/features/enhancements/code-tools.js",
        "src/content/features/chat-prompts/core.js",
        "src/content/features/chat-prompts/index.js",
        "src/content/features/enhancements/toc.js",
        "src/content/main.js"
      ],
      "css": [
        "src/themes/core/base.css",
        "src/themes/components/spaced-grid.css",
        "src/themes/core/premium.css",
        "src/themes/core/features.css",
        "src/themes/palettes/dracula.css",
        "src/themes/palettes/tokyo.css",
        "src/themes/palettes/nord.css",
        "src/themes/components/immersive-cards.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/features/chat-prompts/core.js",
        "src/content/features/chat-prompts/global.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/themes/core/base.css",
        "src/themes/*/*.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
